# ==============================================================================
# Agentic AI Guardrails Framework Configuration
# ==============================================================================

# Pipeline Execution Options
EXECUTION_MODE=sequential          # Options: sequential, parallel
STOP_ON_FIRST_FAILURE=true        # Options: true, false

# Input Guardrail Feature Flags
ENABLE_PROMPT_INJECTION=true
ENABLE_JAILBREAK=true
ENABLE_PII_INPUT=true
ENABLE_INPUT_VALIDATION=true
ENABLE_BUSINESS_INPUT=true

# Output Guardrail Feature Flags
ENABLE_PII_OUTPUT=true
ENABLE_TOXICITY=true
ENABLE_HALLUCINATION=true
ENABLE_CITATION=true
ENABLE_STRUCTURED_OUTPUT=true
ENABLE_BUSINESS_OUTPUT=true

# PII Handling Options (MASK, REJECT, WARN)
PII_INPUT_ACTION=MASK
PII_OUTPUT_ACTION=MASK

# Limits and Validation Thresholds
MAX_PROMPT_SIZE_BYTES=102400       # 100 KB max prompt length
MAX_ATTACHMENT_SIZE_BYTES=10485760 # 10 MB max attachment size
HALLUCINATION_MIN_GROUNDING_SCORE=0.60
TOXICITY_THRESHOLD=0.50
